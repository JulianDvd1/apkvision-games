<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .admin-nav {
      background: var(--bg-card);
      border-bottom: 1px solid var(--border-color);
      padding: 1rem 0;
      margin-bottom: 2rem;
    }
    .admin-tabs {
      display: flex;
      gap: 0.5rem;
      border-bottom: 1px solid var(--border-color);
      margin-bottom: 2rem;
      overflow-x: auto;
    }
    .admin-tab-btn {
      padding: 0.75rem 1.4rem;
      background: none;
      border: none;
      color: var(--text-secondary);
      font-weight: 700;
      font-size: 0.95rem;
      cursor: pointer;
      border-bottom: 3px solid transparent;
      transition: all 0.2s;
      white-space: nowrap;
    }
    .admin-tab-btn.active {
      color: var(--accent-green);
      border-bottom-color: var(--accent-green);
    }
    .tab-content {
      display: none;
    }
    .tab-content.active {
      display: block;
    }
    .game-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 1rem;
      background: var(--bg-card);
      border-radius: var(--radius-md);
      overflow: hidden;
      border: 1px solid var(--border-color);
    }
    .game-table th, .game-table td {
      padding: 0.85rem 1rem;
      text-align: left;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      font-size: 0.88rem;
    }
    .game-table th {
      background: var(--bg-elevated);
      color: var(--text-muted);
      font-weight: 600;
    }
    /* Estilos del Gestor de Enlaces Múltiples */
    .download-file-card {
      background: rgba(14, 20, 32, 0.7);
      border: 1px solid rgba(16, 185, 129, 0.3);
      border-radius: var(--radius-md);
      padding: 1.25rem;
      margin-bottom: 1rem;
      position: relative;
      animation: fadeInDown 0.25s ease;
    }
    .download-file-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.85rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }
    .btn-remove-file {
      background: rgba(239, 68, 68, 0.15);
      color: #ef4444;
      border: 1px solid rgba(239, 68, 68, 0.3);
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 0.78rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn-remove-file:hover {
      background: rgba(239, 68, 68, 0.3);
    }

    /* ================= KPI CARDS DASHBOARD ================= */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .kpi-card {
      background: linear-gradient(135deg, rgba(22, 31, 51, 0.8) 0%, rgba(14, 20, 33, 0.95) 100%);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 1.25rem 1.35rem;
      box-shadow: var(--shadow-card);
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.25s ease;
    }
    .kpi-card:hover {
      border-color: rgba(16, 185, 129, 0.4);
      transform: translateY(-3px);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6), 0 0 18px rgba(16, 185, 129, 0.15);
    }
    .kpi-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 4px;
      height: 100%;
      background: linear-gradient(to bottom, var(--accent-green), var(--accent-cyan));
    }
    .kpi-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.5rem;
    }
    .kpi-title {
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .kpi-icon {
      font-size: 1.35rem;
      opacity: 0.9;
    }
    .kpi-value {
      font-size: 1.85rem;
      font-weight: 900;
      color: var(--text-primary);
      letter-spacing: -0.02em;
      line-height: 1.1;
    }
    .kpi-sub {
      font-size: 0.78rem;
      color: var(--accent-green);
      margin-top: 0.45rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 4px;
    }

    /* ================= CUSTOM DROPZONE STYLES ================= */
    .custom-dropzone {
      position: relative;
      border: 2px dashed rgba(16, 185, 129, 0.35);
      background: rgba(16, 185, 129, 0.03);
      border-radius: var(--radius-md);
      padding: 1.1rem 1.3rem;
      cursor: pointer;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    .custom-dropzone:hover, .custom-dropzone.dragover {
      border-color: var(--accent-green);
      background: rgba(16, 185, 129, 0.08);
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(16, 185, 129, 0.2);
    }
    .dropzone-info {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }
    .dropzone-icon-bubble {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.3rem;
      flex-shrink: 0;
      color: var(--accent-green);
    }
    .dropzone-texts {
      min-width: 0;
    }
    .dropzone-main-text {
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--text-primary);
      display: block;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .dropzone-hint {
      font-size: 0.74rem;
      color: var(--text-muted);
      display: block;
      margin-top: 2px;
    }
    .dropzone-action-btn {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: var(--text-primary);
      font-size: 0.8rem;
      font-weight: 700;
      padding: 0.5rem 0.95rem;
      border-radius: 8px;
      pointer-events: none;
      flex-shrink: 0;
      transition: all 0.2s;
    }
    .custom-dropzone:hover .dropzone-action-btn {
      background: var(--accent-green);
      color: #04120c;
      border-color: var(--accent-green);
      box-shadow: 0 0 12px rgba(16, 185, 129, 0.4);
    }

    /* ================= STATS TAB STYLES ================= */
    .stats-card-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin-bottom: 2rem;
    }
    @media (min-width: 900px) {
      .stats-card-grid {
        grid-template-columns: 1fr 1fr;
      }
    }
    .stats-panel {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 1.5rem;
      box-shadow: var(--shadow-card);
    }
    .stats-panel-title {
      font-size: 1.15rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 1.25rem;
      color: var(--text-primary);
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      padding-bottom: 0.75rem;
    }
    .stats-row {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-bottom: 1.1rem;
    }
    .stats-row-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.88rem;
      font-weight: 600;
    }
    .stats-progress-track {
      width: 100%;
      height: 8px;
      background: rgba(255, 255, 255, 0.05);
      border-radius: 9999px;
      overflow: hidden;
      position: relative;
    }
    .stats-progress-fill {
      height: 100%;
      border-radius: 9999px;
      background: linear-gradient(90deg, var(--accent-green), var(--accent-cyan));
      transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .rank-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 26px;
      height: 26px;
      border-radius: 50%;
      font-size: 0.75rem;
      font-weight: 900;
      flex-shrink: 0;
    }
    .rank-1 { background: linear-gradient(135deg, #f59e0b, #d97706); color: #000; box-shadow: 0 0 10px rgba(245, 158, 11, 0.4); }
    .rank-2 { background: linear-gradient(135deg, #94a3b8, #64748b); color: #fff; }
    .rank-3 { background: linear-gradient(135deg, #b45309, #78350f); color: #fff; }
    .rank-other { background: rgba(255, 255, 255, 0.08); color: var(--text-muted); }
  </style>
</head>
<body>

  <!-- Barra Superior del Panel Privado -->
  <header class="admin-nav">
    <div class="container" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
      <div style="display: flex; align-items: center; gap: 10px;">
        <span style="font-size: 1.4rem;">⚙️</span>
        <strong style="font-size: 1.15rem; color: var(--text-primary);">AuraAPK • Panel de Administración</strong>
        <span style="background: rgba(16, 185, 129, 0.15); color: var(--accent-green); font-size: 0.75rem; padding: 2px 8px; border-radius: 9999px; font-weight: 700;">PRODUCCIÓN</span>
      </div>
      <div style="display: flex; gap: 0.75rem; align-items: center;">
        <a href="/" target="_blank" class="btn btn-secondary" style="padding: 0.4rem 1rem; font-size: 0.85rem;">
          Ver Web Pública ↗
        </a>
        <form action="<%= adminPath %>/logout" method="POST" style="margin: 0;">
          <button type="submit" class="btn btn-secondary" style="padding: 0.4rem 1rem; font-size: 0.85rem; color: #ef4444;">
            Cerrar Sesión
          </button>
        </form>
      </div>
    </div>
  </header>

  <main class="container" style="margin-bottom: 4rem;">

    <% if (message) { %>
      <div style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); color: var(--accent-green); padding: 12px 18px; border-radius: var(--radius-md); margin-bottom: 2rem; font-weight: 600;">
        ✓ <%= message %>
      </div>
    <% } %>

    
    <%
      // Helper calculations for real metrics & KPIs
      const totalRealDownloads = (typeof metrics !== 'undefined' && metrics && metrics.totalDownloads) || 0;
      const totalRealVisits = (typeof metrics !== 'undefined' && metrics && metrics.totalVisits) || 0;
      let totalFilesCount = 0;
      const categoryCounts = {};
      const allFilesList = [];

      games.forEach(g => {
        const cat = g.category || 'Otros';
        categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;

        if (g.downloadFiles && g.downloadFiles.length > 0) {
          totalFilesCount += g.downloadFiles.length;
          g.downloadFiles.forEach(f => {
            allFilesList.push({
              gameTitle: g.title,
              gameId: g.id,
              name: f.name,
              type: f.type || 'APK',
              size: f.size || 'N/A',
              badge: f.badge || '',
              url: f.url
            });
          });
        } else {
          totalFilesCount += 1;
          allFilesList.push({
            gameTitle: g.title,
            gameId: g.id,
            name: g.title + ' (Instalador)',
            type: g.badge || 'APK',
            size: g.size || 'N/A',
            badge: 'Principal',
            url: g.downloadUrl || '#'
          });
        }
      });

      // Ordenar juegos por tráfico y descargas reales en AuraAPK
      const sortedGamesByReal = [...games].sort((a, b) => {
        const dlsA = (typeof metrics !== 'undefined' && metrics && metrics.games && metrics.games[a.id] && metrics.games[a.id].downloads) || 0;
        const dlsB = (typeof metrics !== 'undefined' && metrics && metrics.games && metrics.games[b.id] && metrics.games[b.id].downloads) || 0;
        if (dlsB !== dlsA) return dlsB - dlsA;
        const visA = (typeof metrics !== 'undefined' && metrics && metrics.games && metrics.games[a.id] && metrics.games[a.id].visits) || 0;
        const visB = (typeof metrics !== 'undefined' && metrics && metrics.games && metrics.games[b.id] && metrics.games[b.id].visits) || 0;
        return visB - visA;
      });

      const maxScore = Math.max(1, ...sortedGamesByReal.map(g => {
        const d = (typeof metrics !== 'undefined' && metrics && metrics.games && metrics.games[g.id] && metrics.games[g.id].downloads) || 0;
        const v = (typeof metrics !== 'undefined' && metrics && metrics.games && metrics.games[g.id] && metrics.games[g.id].visits) || 0;
        return d * 2 + v;
      }));
    %>

    <!-- Grid de Métricas Principales (KPIs) -->
    <div class="kpi-grid">
      <div class="kpi-card">
        <div class="kpi-header">
          <span class="kpi-title">Catálogo Activo</span>
          <span class="kpi-icon">🎮</span>
        </div>
        <div class="kpi-value"><%= games.length %></div>
        <div class="kpi-sub">
          <span>✓ Títulos publicados</span>
        </div>
      </div>

      <div class="kpi-card">
        <div class="kpi-header">
          <span class="kpi-title">Descargas Reales AuraAPK</span>
          <span class="kpi-icon">📥</span>
        </div>
        <div class="kpi-value" style="color: var(--accent-green);"><%= totalRealDownloads %></div>
        <div class="kpi-sub">
          <% if (totalRealDownloads === 0) { %>
            <span style="color: var(--text-muted);">Web nueva (0 descargas aún)</span>
          <% } else { %>
            <span>⚡ <%= totalRealDownloads %> descargas reales</span>
          <% } %>
        </div>
      </div>

      <div class="kpi-card">
        <div class="kpi-header">
          <span class="kpi-title">Visitas a Juegos</span>
          <span class="kpi-icon">👁️</span>
        </div>
        <div class="kpi-value" style="color: var(--accent-cyan);"><%= totalRealVisits %></div>
        <div class="kpi-sub">
          <span>⚡ Clics reales a fichas de juego</span>
        </div>
      </div>

      <div class="kpi-card">
        <div class="kpi-header">
          <span class="kpi-title">Enlaces & Archivos</span>
          <span class="kpi-icon">🔗</span>
        </div>
        <div class="kpi-value"><%= totalFilesCount %></div>
        <div class="kpi-sub">
          <span>📦 APKs, ISOs y Texturas</span>
        </div>
      </div>
    </div>

    <!-- Pestañas de Navegación -->
    <div class="admin-tabs">
      <button class="admin-tab-btn active" onclick="switchTab('tab-juegos')">🎮 Catálogo de Juegos (<%= games.length %>)</button>
      <button class="admin-tab-btn" onclick="switchTab('tab-stats')">📊 Métricas & Estadísticas</button>
      <button class="admin-tab-btn" onclick="switchTab('tab-nuevo')">➕ Agregar / Editar Juego</button>
      <button class="admin-tab-btn" onclick="switchTab('tab-ads')">💰 Configuración Adsterra & Monetización</button>
    </div>

    <!-- TAB 1: LISTADO DE JUEGOS -->
    <div id="tab-juegos" class="tab-content active">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 10px;">
        <h2 style="font-size: 1.3rem; font-weight: 800;">Juegos Registrados</h2>
        <button class="btn btn-primary" onclick="switchTab('tab-nuevo'); resetGameForm();">
          + Agregar Nuevo Juego
        </button>
      </div>

      <div style="overflow-x: auto;">
        <table class="game-table">
          <thead>
            <tr>
              <th>Juego</th>
              <th>Categoría</th>
              <th>Versión</th>
              <th>Badge</th>
              <th>Enlaces de Descarga</th>
              <th>Rating</th>
              <th style="text-align: right;">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% games.forEach(g => { 
                const filesCount = (g.downloadFiles && g.downloadFiles.length) ? g.downloadFiles.length : 1;
            %>
              <tr>
                <td style="display: flex; align-items: center; gap: 10px;">
                  <img src="<%= g.icon %>" style="width: 38px; height: 38px; border-radius: 8px; object-fit: cover;" onerror="this.src='/images/placeholder-game.svg'">
                  <div>
                    <strong><%= g.title %></strong>
                    <div style="font-size: 0.75rem; color: var(--text-muted);">/juego/<%= g.slug %></div>
                  </div>
                </td>
                <td><span style="background: rgba(255,255,255,0.06); padding: 2px 8px; border-radius: 4px; font-weight: 600;"><%= g.category %></span></td>
                <td><%= g.version %></td>
                <td><span class="game-badge" style="position: static;"><%= g.badge %></span></td>
                <td>
                  <div style="display: flex; align-items: center; gap: 6px;">
                    <span style="background: rgba(16, 185, 129, 0.15); color: var(--accent-green); padding: 2px 7px; border-radius: 4px; font-weight: 800; font-size: 0.78rem;">
                      <%= filesCount %> <%= filesCount === 1 ? 'enlace' : 'enlaces' %>
                    </span>
                    <span style="color: var(--text-muted); font-size: 0.78rem;">(<%= g.size %>)</span>
                  </div>
                </td>
                <td><span style="color: var(--accent-amber); font-weight: 700;">★ <%= g.rating %></span></td>
                <td style="text-align: right; white-space: nowrap;">
                  <button class="btn btn-secondary" style="padding: 5px 10px; font-size: 0.8rem;" onclick="editGameById('<%= g.id %>')">
                    ✏️ Editar
                  </button>
                  <form action="<%= adminPath %>/juego/<%= g.id %>/eliminar" method="POST" style="display: inline;" onsubmit="return confirm('¿Seguro que deseas eliminar este juego del catálogo?');">
                    <button type="submit" class="btn btn-secondary" style="padding: 5px 10px; font-size: 0.8rem; color: #ef4444; border-color: rgba(239, 68, 68, 0.3);">
                      🗑️
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    
    <!-- TAB: MÉTRICAS Y ESTADÍSTICAS -->
    <div id="tab-stats" class="tab-content">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 10px;">
        <div>
          <h2 style="font-size: 1.35rem; font-weight: 800; display: flex; align-items: center; gap: 8px;">
            <span>📊</span> Métricas Reales de Tráfico & Rendimiento
          </h2>
          <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 3px;">
            Contadores 100% reales de visitas y descargas efectuadas en AuraAPK desde el lanzamiento.
          </p>
        </div>
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
          <button class="btn btn-secondary" onclick="window.location.reload();" style="font-size: 0.82rem; padding: 0.45rem 0.9rem;">
            🔄 Actualizar Métricas
          </button>
          <form action="<%= adminPath %>/metricas/reset" method="POST" onsubmit="return confirm('¿Seguro que deseas reiniciar todos los contadores de visitas y descargas reales a 0?');" style="margin: 0;">
            <button type="submit" class="btn btn-secondary" style="font-size: 0.82rem; padding: 0.45rem 0.9rem; color: #ef4444; border-color: rgba(239, 68, 68, 0.4);">
              🗑️ Reiniciar Contadores a 0
            </button>
          </form>
        </div>
      </div>

      <div class="stats-card-grid">
        <!-- Panel 1: Top Juegos Más Visitados / Populares -->
        <div class="stats-panel">
          <div class="stats-panel-title" style="justify-content: space-between;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <span>🔥</span> Tráfico Real por Juego en AuraAPK
            </div>
            <span style="font-size: 0.72rem; color: var(--accent-green); font-weight: 700; background: rgba(16, 185, 129, 0.15); padding: 2px 8px; border-radius: 9999px;">
              100% REAL
            </span>
          </div>
          <% sortedGamesByReal.forEach((g, idx) => { 
               const gDownloads = (typeof metrics !== 'undefined' && metrics && metrics.games && metrics.games[g.id] && metrics.games[g.id].downloads) || 0;
               const gVisits = (typeof metrics !== 'undefined' && metrics && metrics.games && metrics.games[g.id] && metrics.games[g.id].visits) || 0;
               const score = gDownloads * 2 + gVisits;
               const pct = maxScore > 0 && score > 0 ? Math.min(100, Math.round((score / maxScore) * 100)) : 0;
               const rankClass = idx === 0 ? 'rank-1' : (idx === 1 ? 'rank-2' : (idx === 2 ? 'rank-3' : 'rank-other'));
          %>
            <div class="stats-row">
              <div class="stats-row-header">
                <div style="display: flex; align-items: center; gap: 10px; min-width: 0;">
                  <span class="rank-badge <%= rankClass %>">#<%= idx + 1 %></span>
                  <img src="<%= g.icon || '/images/placeholder-game.svg' %>" style="width: 28px; height: 28px; border-radius: 6px; object-fit: cover;">
                  <span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 190px;" title="<%= g.title %>">
                    <%= g.title %>
                  </span>
                </div>
                <div style="display: flex; align-items: center; gap: 8px; flex-shrink: 0;">
                  <span style="font-size: 0.72rem; color: var(--text-muted); background: rgba(255,255,255,0.05); padding: 2px 7px; border-radius: 4px;">
                    <%= gVisits %> visitas
                  </span>
                  <span style="color: var(--accent-green); font-weight: 800; font-size: 0.88rem;">
                    <%= gDownloads %> descargas
                  </span>
                </div>
              </div>
              <div class="stats-progress-track">
                <div class="stats-progress-fill" style="width: <%= Math.max(pct, score > 0 ? 5 : 0) %>%;"></div>
              </div>
            </div>
          <% }); %>

          <% if (totalRealDownloads === 0 && totalRealVisits === 0) { %>
            <div style="background: rgba(255, 255, 255, 0.02); border: 1px dashed rgba(255, 255, 255, 0.12); border-radius: 8px; padding: 12px; margin-top: 12px; text-align: center;">
              <span style="font-size: 0.8rem; color: var(--text-muted); display: block;">
                ℹ️ La web acaba de publicarse. Conforme los visitantes naveguen y descarguen, estos contadores sumarán en vivo.
              </span>
            </div>
          <% } %>
        </div>

        <!-- Panel 2: Desglose por Categorías & Monetización -->
        <div class="stats-panel">
          <div class="stats-panel-title">
            <span>🏷️</span> Distribución por Géneros & Categorías
          </div>
          <% Object.keys(categoryCounts).forEach(cat => { 
               const count = categoryCounts[cat];
               const pct = Math.round((count / games.length) * 100);
          %>
            <div class="stats-row">
              <div class="stats-row-header">
                <span style="color: var(--text-primary); font-weight: 600;"><%= cat %></span>
                <span style="color: var(--accent-cyan); font-weight: 700;"><%= count %> juegos (<%= pct %>%)</span>
              </div>
              <div class="stats-progress-track">
                <div class="stats-progress-fill" style="width: <%= pct %>%; background: linear-gradient(90deg, var(--accent-cyan), #3b82f6);"></div>
              </div>
            </div>
          <% }); %>

          <div style="margin-top: 1.5rem; padding-top: 1.2rem; border-top: 1px solid rgba(255,255,255,0.06);">
            <div style="font-size: 0.9rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 6px;">
              <span>💰</span> Bloques de Monetización Adsterra
            </div>
            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; font-size: 0.8rem;">
              <div style="background: rgba(255,255,255,0.03); padding: 8px 10px; border-radius: 6px; border: 1px solid var(--border-color);">
                <span style="color: var(--text-muted); display: block; font-size: 0.72rem;">Banner Nativo 4x1</span>
                <span style="color: var(--accent-green); font-weight: 700;">● Feed & Catálogo</span>
              </div>
              <div style="background: rgba(255,255,255,0.03); padding: 8px 10px; border-radius: 6px; border: 1px solid var(--border-color);">
                <span style="color: var(--text-muted); display: block; font-size: 0.72rem;">Rectángulo 300x250</span>
                <span style="color: var(--accent-green); font-weight: 700;">● Sidebar & Descarga</span>
              </div>
              <div style="background: rgba(255,255,255,0.03); padding: 8px 10px; border-radius: 6px; border: 1px solid var(--border-color);">
                <span style="color: var(--text-muted); display: block; font-size: 0.72rem;">Temporizador 10s</span>
                <span style="color: var(--accent-green); font-weight: 700;">● 100% Retención</span>
              </div>
              <div style="background: rgba(255,255,255,0.03); padding: 8px 10px; border-radius: 6px; border: 1px solid var(--border-color);">
                <span style="color: var(--text-muted); display: block; font-size: 0.72rem;">Popunder & Social</span>
                <span style="color: var(--accent-green); font-weight: 700;">● Ganancia Máxima</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Panel 3: Lista de Enlaces y Archivos Gestionados -->
      <div class="stats-panel">
        <div class="stats-panel-title" style="justify-content: space-between; flex-wrap: wrap; gap: 8px;">
          <div style="display: flex; align-items: center; gap: 8px;">
            <span>🔗</span> Enlaces de Descarga Gestionados en Todo el Catálogo (<%= allFilesList.length %>)
          </div>
          <span style="font-size: 0.78rem; font-weight: normal; color: var(--text-muted);">
            Todos pasan por la página monetizada
          </span>
        </div>
        <div style="overflow-x: auto;">
          <table class="game-table" style="font-size: 0.85rem;">
            <thead>
              <tr>
                <th>Juego Asociado</th>
                <th>Nombre del Archivo</th>
                <th>Tipo</th>
                <th>Tamaño</th>
                <th>Etiqueta</th>
                <th>Descargas Reales</th>
                <th>Destino</th>
              </tr>
            </thead>
            <tbody>
              <% allFilesList.forEach(file => { 
                   const fDownloads = (typeof metrics !== 'undefined' && metrics && metrics.files && metrics.files[file.url] && metrics.files[file.url].downloads) || 0;
              %>
                <tr>
                  <td style="font-weight: 700; color: var(--text-primary);"><%= file.gameTitle %></td>
                  <td style="color: var(--text-secondary);"><%= file.name %></td>
                  <td>
                    <span style="background: rgba(6, 182, 212, 0.15); color: var(--accent-cyan); padding: 2px 7px; border-radius: 4px; font-weight: 700; font-size: 0.72rem;">
                      <%= file.type %>
                    </span>
                  </td>
                  <td style="color: var(--text-muted);"><%= file.size %></td>
                  <td>
                    <span style="background: rgba(16, 185, 129, 0.15); color: var(--accent-green); padding: 2px 7px; border-radius: 4px; font-weight: 700; font-size: 0.72rem;">
                      <%= file.badge || 'Descarga' %>
                    </span>
                  </td>
                  <td style="color: var(--accent-green); font-weight: 700;">
                    <%= fDownloads %>
                  </td>
                  <td>
                    <a href="<%= file.url %>" target="_blank" rel="noopener noreferrer" style="color: var(--accent-cyan); text-decoration: none; font-size: 0.78rem; display: inline-flex; align-items: center; gap: 4px;">
                      Enlace ↗
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- TAB 2: AGREGAR / EDITAR JUEGO CON GESTOR MULTI-ENLACES -->
    <div id="tab-nuevo" class="tab-content">
      <div class="admin-card">
        <h2 id="formTitle" style="font-size: 1.3rem; font-weight: 800; margin-bottom: 1.5rem;">
          Agregar Nuevo Juego al Catálogo
        </h2>

        <!-- Alerta de Borrador Automático Recuperado -->
        <div id="draftAlert" style="display: none; background: rgba(16, 185, 129, 0.15); border: 1px solid var(--accent-green); border-radius: var(--radius-md); padding: 12px 16px; margin-bottom: 20px; justify-content: space-between; align-items: center; gap: 10px;">
          <div style="display: flex; align-items: center; gap: 8px; font-size: 0.88rem; color: var(--text-primary);">
            <span style="font-size: 1.2rem;">💾</span>
            <span><strong>Borrador restaurado:</strong> Se recuperaron automáticamente los datos que estabas escribiendo para que no pierdas nada.</span>
          </div>
          <button type="button" onclick="clearGameDraft()" class="btn btn-secondary" style="font-size: 0.78rem; padding: 4px 10px; flex-shrink: 0;">Descartar borrador</button>
        </div>

        <form action="<%= adminPath %>/juego/guardar" method="POST" enctype="multipart/form-data" id="gameForm">
          <input type="hidden" name="id" id="game_id" value="">

          <div class="form-row cols-2">
            <div class="form-group">
              <label class="form-label">Título del Juego *</label>
              <input type="text" name="title" id="game_title" class="form-control" placeholder="Ej: Super Mario Strikers" required>
            </div>
            <div class="form-group">
              <label class="form-label">Categoría *</label>
              <select name="category" id="game_category" class="form-control">
                <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                  <% categories.filter(c => c.slug !== 'todos').forEach(cat => { %>
                    <option value="<%= cat.name %>"><%= cat.name %></option>
                  <% }) %>
                <% } else { %>
                  <option value="Deportes">Deportes</option>
                  <option value="Acción">Acción</option>
                  <option value="Aventura">Aventura</option>
                  <option value="Carreras">Carreras</option>
                  <option value="Estrategia">Estrategia</option>
                  <option value="Arcade">Arcade</option>
                  <option value="Disparos (Shooter)">Disparos (Shooter)</option>
                  <option value="Simulación">Simulación</option>
                  <option value="RPG">RPG</option>
                  <option value="Lucha & Pelea">Lucha & Pelea</option>
                  <option value="Terror & Supervivencia">Terror & Supervivencia</option>
                <% } %>
              </select>
            </div>
          </div>

          <div class="form-row cols-3">
            <div class="form-group">
              <label class="form-label">Etiqueta Principal (Badge)</label>
              <input type="text" name="badge" id="game_badge" class="form-control" placeholder="MOD APK / APK + ISO / VIP" value="MOD APK">
            </div>
            <div class="form-group">
              <label class="form-label">Versión General</label>
              <input type="text" name="version" id="game_version" class="form-control" placeholder="v1.0.0" value="v1.0.0">
            </div>
            <div class="form-group">
              <label class="form-label">Tamaño Total</label>
              <input type="text" name="size" id="game_size" class="form-control" placeholder="1.48 GB" value="100 MB">
            </div>
          </div>

          <div class="form-row cols-3">
            <div class="form-group">
              <label class="form-label">Requisitos Mínimos Android</label>
              <input type="text" name="requiresAndroid" id="game_requiresAndroid" class="form-control" placeholder="Android 7.0+ (OpenGL ES 3.0)" value="Android 6.0+">
            </div>
            <div class="form-group">
              <label class="form-label">Desarrollador / Estudio</label>
              <input type="text" name="developer" id="game_developer" class="form-control" placeholder="Nintendo / Rockstar / Gameloft" value="Desconocido">
            </div>
            <div class="form-group">
              <label class="form-label">Calificación (Rating 1.0 - 5.0)</label>
              <input type="number" step="0.1" name="rating" id="game_rating" class="form-control" value="4.8">
            </div>
          </div>

          <!-- ================= GESTOR DINÁMICO DE ENLACES DE DESCARGA ================= -->
          <div style="background: rgba(16, 185, 129, 0.05); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: var(--radius-lg); padding: 1.5rem; margin: 1.8rem 0;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 10px;">
              <div>
                <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--accent-green); display: flex; align-items: center; gap: 8px;">
                  <span>🔗</span> Enlaces de Descarga Externos (Multi-Archivos)
                </h3>
                <p style="font-size: 0.82rem; color: var(--text-muted); margin-top: 2px;">
                  Puedes añadir tantos archivos como requiera el juego (APK instalador, ROM ISO, Texturas HD, OBB, etc.). Cada enlace pasará por el temporizador monetizado.
                </p>
              </div>
              <button type="button" class="btn btn-primary" style="padding: 0.5rem 1rem; font-size: 0.85rem;" onclick="addDownloadFileRow()">
                + Agregar Otro Enlace
              </button>
            </div>

            <!-- Contenedor dinámico donde se agregan los enlaces -->
            <div id="downloadFilesContainer"></div>
          </div>

          <div class="form-row cols-2">
            <div class="form-group" style="background: rgba(255, 255, 255, 0.02); padding: 1.15rem; border-radius: var(--radius-md); border: 1px solid var(--border-color);">
              <label class="form-label" style="display: flex; align-items: center; gap: 6px; color: var(--accent-green); font-weight: 700;">
                <span>🖼️</span> Icono de la App (Subir desde PC)
              </label>
              
              <!-- Custom Dropzone Elegante para Icono -->
              <div class="custom-dropzone" id="dropzone_icon" onclick="document.getElementById('game_iconFile').click()" style="margin-bottom: 8px;">
                <input type="file" name="iconFile" id="game_iconFile" accept="image/*" style="display: none;" onchange="handleDropzoneFile(this, 'icon', 'dropzone_icon_label', 'iconPreview', 'iconPreviewImg')">
                <div class="dropzone-info">
                  <div class="dropzone-icon-bubble">📁</div>
                  <div class="dropzone-texts">
                    <span class="dropzone-main-text" id="dropzone_icon_label">Subir Icono desde tu PC</span>
                    <span class="dropzone-hint">Haz clic o arrastra un archivo PNG, JPG o WEBP</span>
                  </div>
                </div>
                <div class="dropzone-action-btn">Explorar PC</div>
              </div>

              <div id="iconPreview" style="display: none; margin: 10px 0; align-items: center; gap: 12px; background: rgba(0,0,0,0.3); padding: 8px 12px; border-radius: 8px;">
                <img id="iconPreviewImg" src="" style="width: 52px; height: 52px; border-radius: 12px; object-fit: cover; border: 1px solid var(--accent-green); box-shadow: 0 4px 10px rgba(0,0,0,0.5);">
                <div>
                  <span style="font-size: 0.8rem; color: var(--accent-green); font-weight: 700; display: block;">✓ Imagen cargada</span>
                  <span style="font-size: 0.72rem; color: var(--text-muted);">Se aplicará al guardar</span>
                </div>
              </div>

              <label style="font-size: 0.76rem; color: var(--text-muted); display: block; margin-top: 8px;">
                O escribe una ruta o URL web existente:
              </label>
              <input type="text" name="icon" id="game_icon" class="form-control" placeholder="/uploads/games/... o https://..." value="/images/placeholder-game.svg">
            </div>

            <div class="form-group" style="background: rgba(255, 255, 255, 0.02); padding: 1.15rem; border-radius: var(--radius-md); border: 1px solid var(--border-color);">
              <label class="form-label" style="display: flex; align-items: center; gap: 6px; color: var(--accent-cyan); font-weight: 700;">
                <span>🌄</span> Banner Panorámico HD (Subir desde PC)
              </label>

              <!-- Custom Dropzone Elegante para Banner -->
              <div class="custom-dropzone" id="dropzone_banner" onclick="document.getElementById('game_bannerFile').click()" style="margin-bottom: 8px; border-color: rgba(6, 182, 212, 0.35); background: rgba(6, 182, 212, 0.03);">
                <input type="file" name="bannerFile" id="game_bannerFile" accept="image/*" style="display: none;" onchange="handleDropzoneFile(this, 'banner', 'dropzone_banner_label', 'bannerPreview', 'bannerPreviewImg')">
                <div class="dropzone-info">
                  <div class="dropzone-icon-bubble" style="background: rgba(6, 182, 212, 0.12); border-color: rgba(6, 182, 212, 0.3); color: var(--accent-cyan);">🌄</div>
                  <div class="dropzone-texts">
                    <span class="dropzone-main-text" id="dropzone_banner_label">Subir Banner Panorámico HD</span>
                    <span class="dropzone-hint">Haz clic o arrastra un banner de alta resolución</span>
                  </div>
                </div>
                <div class="dropzone-action-btn" style="border-color: rgba(6, 182, 212, 0.3);">Explorar PC</div>
              </div>

              <div id="bannerPreview" style="display: none; margin: 10px 0; align-items: center; gap: 12px; background: rgba(0,0,0,0.3); padding: 8px 12px; border-radius: 8px;">
                <img id="bannerPreviewImg" src="" style="width: 110px; height: 52px; border-radius: 8px; object-fit: cover; border: 1px solid var(--accent-cyan); box-shadow: 0 4px 10px rgba(0,0,0,0.5);">
                <div>
                  <span style="font-size: 0.8rem; color: var(--accent-cyan); font-weight: 700; display: block;">✓ Banner cargado</span>
                  <span style="font-size: 0.72rem; color: var(--text-muted);">Se aplicará al guardar</span>
                </div>
              </div>

              <label style="font-size: 0.76rem; color: var(--text-muted); display: block; margin-top: 8px;">
                O escribe una ruta o URL web existente:
              </label>
              <input type="text" name="banner" id="game_banner" class="form-control" placeholder="/uploads/games/... o https://..." value="/images/placeholder-game.svg">
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Descripción Corta (Para tarjetas y buscadores)</label>
            <input type="text" name="shortDescription" id="game_shortDescription" class="form-control" placeholder="Resumen llamativo de una sola línea">
          </div>

          <div class="form-group">
            <label class="form-label">Descripción Completa del Juego</label>
            <textarea name="description" id="game_description" class="form-control" rows="4" placeholder="Explica de qué trata el juego, modos de juego, controles táctiles..."></textarea>
          </div>

          <div class="form-group">
            <label class="form-label">Características del MOD o Ventajas (Una por línea)</label>
            <textarea name="modFeatures" id="game_modFeatures" class="form-control" rows="3" placeholder="60 FPS estables desbloqueados&#10;Pack de Texturas HD incluido&#10;Controles táctiles optimizados"></textarea>
          </div>

          <!-- Gestor de Capturas de Pantalla desde PC + URLs -->
          <div class="form-group" style="background: rgba(6, 182, 212, 0.04); border: 1px solid rgba(6, 182, 212, 0.25); border-radius: var(--radius-md); padding: 1.25rem;">
            <label class="form-label" style="font-size: 1rem; font-weight: 800; color: var(--accent-cyan); display: flex; align-items: center; gap: 8px; margin-bottom: 0.4rem;">
              <span>📸</span> Capturas de Pantalla del Juego (Subir desde PC)
            </label>
            <p style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 0.85rem;">
              Selecciona una o varias imágenes desde tu ordenador (puedes arrastrar o seleccionar varias manteniendo presionada la tecla Ctrl / Shift).
            </p>

            <!-- Custom Dropzone Elegante para Capturas Múltiples -->
            <div class="custom-dropzone" id="dropzone_screenshots" onclick="document.getElementById('game_screenshotFiles').click()" style="border-color: rgba(6, 182, 212, 0.4); background: rgba(6, 182, 212, 0.04); margin-bottom: 0.85rem; padding: 1.25rem 1.4rem;">
              <input type="file" name="screenshotFiles" id="game_screenshotFiles" accept="image/*" multiple style="display: none;" onchange="handleDropzoneScreenshots(this)">
              <div class="dropzone-info">
                <div class="dropzone-icon-bubble" style="background: rgba(6, 182, 212, 0.15); border-color: rgba(6, 182, 212, 0.4); color: var(--accent-cyan); width: 48px; height: 48px; font-size: 1.4rem;">📸</div>
                <div class="dropzone-texts">
                  <span class="dropzone-main-text" id="dropzone_screenshots_label">Seleccionar Capturas de Pantalla Múltiples</span>
                  <span class="dropzone-hint">Haz clic o arrastra varias imágenes juntas (Ctrl + Clic para elegir varias)</span>
                </div>
              </div>
              <div class="dropzone-action-btn" style="background: rgba(6, 182, 212, 0.15); border-color: var(--accent-cyan); color: #fff;">
                Seleccionar Imágenes
              </div>
            </div>

            <!-- Previsualización de imágenes seleccionadas en PC -->
            <div id="screenshotsFilesPreview" style="display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 0.85rem;"></div>

            <label class="form-label" style="font-size: 0.82rem; color: var(--text-secondary); margin-bottom: 4px;">
              Rutas o enlaces de capturas (Una por línea, se conservan o complementan automáticamente):
            </label>
            <textarea name="screenshots" id="game_screenshots" class="form-control" rows="3" placeholder="/uploads/mario-strikers/super-mario-strikers-1.png&#10;/uploads/mario-strikers/super-mario-strikers-2.png"></textarea>
          </div>

          <div class="form-group">
            <label class="switch-label">
              <input type="checkbox" name="featured" id="game_featured">
              <span>Destacar en el Hero principal de la página de inicio</span>
            </label>
          </div>

          <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
            <button type="submit" class="btn btn-primary">
              Guardar Juego
            </button>
            <button type="button" class="btn btn-secondary" onclick="resetGameForm(); switchTab('tab-juegos');">
              Cancelar
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- TAB 3: CONFIGURACIÓN DE ADSTERRA -->
    <div id="tab-ads" class="tab-content">
      <div class="admin-card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
          <div>
            <h2 style="font-size: 1.3rem; font-weight: 800;">Configuración de Anuncios y Monetización</h2>
            <p style="color: var(--text-muted); font-size: 0.88rem; margin-top: 4px;">
              Configura tus bloques de Adsterra (Social Bar, Banners, Native y Smartlink).
            </p>
          </div>
        </div>

        <form action="<%= adminPath %>/ads/guardar" method="POST">
          
          <!-- Controles Maestros -->
          <div style="background: var(--bg-elevated); padding: 1.5rem; border-radius: var(--radius-md); margin-bottom: 2rem; border: 1px solid var(--border-color);">
            <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 1rem; color: var(--accent-cyan);">
              Ajustes Generales de Monetización
            </h3>

            <div class="form-row cols-2" style="margin-bottom: 1.25rem;">
              <label class="switch-label">
                <input type="checkbox" name="enabled" <%= ads.enabled ? 'checked' : '' %>>
                <span><strong>Habilitar Anuncios Globalmente</strong></span>
              </label>

              <label class="switch-label">
                <input type="checkbox" name="testMode" <%= ads.testMode ? 'checked' : '' %>>
                <span><strong>Modo Prueba</strong> (Muestra cajas ilustrativas en vez de los anuncios reales)</span>
              </label>
            </div>

            <div class="form-row cols-2">
              <div class="form-group">
                <label class="form-label">Segundos de Cuenta Regresiva (Página de Descarga)</label>
                <input type="number" name="downloadCountdownSeconds" class="form-control" value="<%= ads.settings.downloadCountdownSeconds || 6 %>" min="2" max="30">
                <small style="color: var(--text-muted);">Recomendado: 5 a 8 segundos para dar tiempo al usuario de ver el anuncio.</small>
              </div>

              <div class="form-group">
                <label class="form-label">Adsterra Direct Link (Smartlink)</label>
                <input type="url" name="directLinkUrl" class="form-control" placeholder="https://..." value="<%= ads.slots.directLinkUrl || '' %>">
                <label class="switch-label" style="margin-top: 8px; font-size: 0.82rem;">
                  <input type="checkbox" name="directLinkBeforeDownload" <%= ads.settings.directLinkBeforeDownload ? 'checked' : '' %>>
                  <span>Abrir Direct Link automáticamente al terminar la cuenta regresiva</span>
                </label>
              </div>
            </div>
          </div>

          <!-- Slots de Anuncios -->
          <h3 style="font-size: 1.15rem; font-weight: 800; margin: 1.5rem 0 1rem;">
            Formatos de Anuncios Adsterra
          </h3>

          <!-- Slot: Header 728x90 -->
          <div class="admin-card" style="background: rgba(255,255,255,0.02);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
              <label class="switch-label">
                <input type="checkbox" name="headerBanner_enabled" <%= (ads.slots.headerBanner && ads.slots.headerBanner.enabled) ? 'checked' : '' %>>
                <strong>Banner Superior (Header 728x90 / 320x50 Mobile)</strong>
              </label>
            </div>
            <textarea name="headerBanner_code" class="form-control" rows="3" placeholder="Pega el código HTML/JS proporcionado por Adsterra"><%= (ads.slots.headerBanner) ? ads.slots.headerBanner.code : '' %></textarea>
          </div>

          <!-- Slot: Native In-Feed -->
          <div class="admin-card" style="background: rgba(255,255,255,0.02);">
            <label class="switch-label" style="margin-bottom: 0.5rem;">
              <input type="checkbox" name="inFeedNative_enabled" <%= (ads.slots.inFeedNative && ads.slots.inFeedNative.enabled) ? 'checked' : '' %>>
              <strong>Banner Nativo en Catálogo (Native Banners)</strong>
            </label>
            <textarea name="inFeedNative_code" class="form-control" rows="3" placeholder="Pega el código del Native Banner de Adsterra"><%= (ads.slots.inFeedNative) ? ads.slots.inFeedNative.code : '' %></textarea>
          </div>

          <!-- Slot: Game Detail Sidebar 300x250 -->
          <div class="admin-card" style="background: rgba(255,255,255,0.02);">
            <label class="switch-label" style="margin-bottom: 0.5rem;">
              <input type="checkbox" name="gameDetailTop_enabled" <%= (ads.slots.gameDetailTop && ads.slots.gameDetailTop.enabled) ? 'checked' : '' %>>
              <strong>Sidebar de la Ficha del Juego (300x250 Medium Rectangle)</strong>
            </label>
            <textarea name="gameDetailTop_code" class="form-control" rows="3" placeholder="Pega el código de banner 300x250 para el sidebar"><%= (ads.slots.gameDetailTop) ? ads.slots.gameDetailTop.code : '' %></textarea>
          </div>

          <!-- Slot: Game Detail Sidebar Skyscraper 300x600 -->
          <div class="admin-card" style="background: rgba(255,255,255,0.02);">
            <label class="switch-label" style="margin-bottom: 0.5rem;">
              <input type="checkbox" name="sidebarSticky_enabled" <%= (ads.slots.sidebarSticky && ads.slots.sidebarSticky.enabled) ? 'checked' : '' %>>
              <strong>Sidebar Lateral Ficha (300x600 Half Page / Skyscraper Vertical - Espacio Largo)</strong>
            </label>
            <textarea name="sidebarSticky_code" class="form-control" rows="3" placeholder="Pega el código de banner vertical 300x600 o 160x600 de Adsterra"><%= (ads.slots.sidebarSticky) ? ads.slots.sidebarSticky.code : '' %></textarea>
          </div>

          <!-- Slot: Download Countdown Banner -->
          <div class="admin-card" style="background: rgba(255,255,255,0.02);">
            <label class="switch-label" style="margin-bottom: 0.5rem;">
              <input type="checkbox" name="downloadPageBanner_enabled" <%= (ads.slots.downloadPageBanner && ads.slots.downloadPageBanner.enabled) ? 'checked' : '' %>>
              <strong>Página de Cuenta Regresiva de Descarga (300x250 - Máximo CPM)</strong>
            </label>
            <textarea name="downloadPageBanner_code" class="form-control" rows="3" placeholder="Pega el código de banner para la pantalla de descarga"><%= (ads.slots.downloadPageBanner) ? ads.slots.downloadPageBanner.code : '' %></textarea>
          </div>

          <!-- Slot: Social Bar -->
          <div class="admin-card" style="background: rgba(255,255,255,0.02);">
            <label class="switch-label" style="margin-bottom: 0.5rem;">
              <input type="checkbox" name="socialBar_enabled" <%= (ads.slots.socialBar && ads.slots.socialBar.enabled) ? 'checked' : '' %>>
              <strong>Social Bar / In-Page Push (Adsterra)</strong>
            </label>
            <textarea name="socialBar_code" class="form-control" rows="3" placeholder="Pega el script de Social Bar de Adsterra"><%= (ads.slots.socialBar) ? ads.slots.socialBar.code : '' %></textarea>
          </div>

          <!-- Slot: Popunder -->
          <div class="admin-card" style="background: rgba(255,255,255,0.02);">
            <label class="switch-label" style="margin-bottom: 0.5rem;">
              <input type="checkbox" name="popunder_enabled" <%= (ads.slots.popunder && ads.slots.popunder.enabled) ? 'checked' : '' %>>
              <strong>Popunder OnClick (Adsterra)</strong>
            </label>
            <textarea name="popunder_code" class="form-control" rows="3" placeholder="Pega el script de Popunder de Adsterra"><%= (ads.slots.popunder) ? ads.slots.popunder.code : '' %></textarea>
          </div>

          <button type="submit" class="btn btn-primary" style="margin-top: 1rem;">
            Guardar Configuración de Adsterra
          </button>
        </form>
      </div>
    </div>

  </main>

  <script>
    const allGamesData = <%- JSON.stringify(games).replace(/</g, '\\u003c') %>;

    function editGameById(id) {
      const game = allGamesData.find(g => g.id === id || g.slug === id);
      if (game) {
        editGame(game);
      }
    }

    function switchTab(tabId, btn) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.admin-tab-btn').forEach(el => el.classList.remove('active'));
      
      const target = document.getElementById(tabId);
      if (target) target.classList.add('active');
      
      if (btn && btn.classList) {
        btn.classList.add('active');
      } else {
        const matchingBtn = document.querySelector(`.admin-tab-btn[onclick*="${tabId}"]`);
        if (matchingBtn) matchingBtn.classList.add('active');
      }
    }

    // ================= GESTOR DINÁMICO DE ENLACES =================
    let fileCounter = 0;

    function addDownloadFileRow(fileData = {}) {
      fileCounter++;
      const container = document.getElementById('downloadFilesContainer');
      const card = document.createElement('div');
      card.className = 'download-file-card';
      card.id = 'downloadFileRow_' + fileCounter;

      const name = fileData.name || '';
      const type = fileData.type || 'APK';
      const size = fileData.size || '';
      const badge = fileData.badge || 'Descarga Directa';
      const url = fileData.url || '';

      card.innerHTML = `
        <div class="download-file-header">
          <strong style="color: var(--accent-green); font-size: 0.9rem;">
            📦 Enlace de Descarga #${fileCounter}
          </strong>
          <button type="button" class="btn-remove-file" onclick="removeDownloadFileRow(${fileCounter})">
            ✕ Eliminar
          </button>
        </div>

        <div class="form-row cols-3" style="margin-bottom: 0.75rem;">
          <div>
            <label class="form-label" style="font-size: 0.8rem;">Nombre del Archivo / Botón *</label>
            <input type="text" name="file_name[]" class="form-control" placeholder="Ej: Super Mario Strikers (ROM ISO)" value="${escapeHtml(name)}" required>
          </div>
          <div>
            <label class="form-label" style="font-size: 0.8rem;">Tipo de Archivo</label>
            <select name="file_type[]" class="form-control">
              <option value="APK" ${type === 'APK' ? 'selected' : ''}>APK (Instalador)</option>
              <option value="ISO" ${type === 'ISO' ? 'selected' : ''}>ISO (ROM de Juego)</option>
              <option value="OBB" ${type === 'OBB' ? 'selected' : ''}>OBB (Datos adicionales)</option>
              <option value="ZIP / HD" ${type.includes('ZIP') || type.includes('HD') ? 'selected' : ''}>ZIP / Texturas HD</option>
              <option value="DATA" ${type === 'DATA' ? 'selected' : ''}>DATA / Guardado</option>
            </select>
          </div>
          <div>
            <label class="form-label" style="font-size: 0.8rem;">Peso / Tamaño *</label>
            <input type="text" name="file_size[]" class="form-control" placeholder="Ej: 1.35 GB o 18 MB" value="${escapeHtml(size)}" required>
          </div>
        </div>

        <div class="form-row cols-2">
          <div>
            <label class="form-label" style="font-size: 0.8rem;">Etiqueta (Badge)</label>
            <input type="text" name="file_badge[]" class="form-control" placeholder="Ej: Juego Base, Instalador Obligatorio..." value="${escapeHtml(badge)}">
          </div>
          <div>
            <label class="form-label" style="font-size: 0.8rem;">Enlace Externo (MediaFire, Mega, Drive...) *</label>
            <input type="url" name="file_url[]" class="form-control" placeholder="https://mediafire.com/... o https://drive.google.com/..." value="${escapeHtml(url)}" required>
          </div>
        </div>
      `;

      container.appendChild(card);
    }

    function removeDownloadFileRow(rowId) {
      const row = document.getElementById('downloadFileRow_' + rowId);
      if (row) {
        row.remove();
      }
    }

    function escapeHtml(text) {
      if (!text) return '';
      return String(text).replace(/"/g, '&quot;');
    }

    function previewImageFile(input, containerId, imgId) {
      const container = document.getElementById(containerId);
      const img = document.getElementById(imgId);
      if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
          img.src = e.target.result;
          container.style.display = 'flex';
        };
        reader.readAsDataURL(input.files[0]);
      } else {
        container.style.display = 'none';
      }
    }

    function previewScreenshotsFromFiles(input) {
      const previewDiv = document.getElementById('screenshotsFilesPreview');
      previewDiv.innerHTML = '';
      if (input.files && input.files.length > 0) {
        Array.from(input.files).forEach((file, idx) => {
          const reader = new FileReader();
          reader.onload = function(e) {
            const thumbWrap = document.createElement('div');
            thumbWrap.style.cssText = 'position: relative; width: 110px; height: 65px; border-radius: 8px; overflow: hidden; border: 1px solid var(--accent-cyan); box-shadow: 0 4px 10px rgba(0,0,0,0.5); background: #000;';
            
            const img = document.createElement('img');
            img.src = e.target.result;
            img.style.cssText = 'width: 100%; height: 100%; object-fit: cover;';
            
            const badge = document.createElement('span');
            badge.textContent = '#' + (idx + 1);
            badge.style.cssText = 'position: absolute; bottom: 3px; right: 3px; background: rgba(0,0,0,0.75); color: #fff; font-size: 0.65rem; padding: 1px 5px; border-radius: 4px; font-weight: 700;';
            
            thumbWrap.appendChild(img);
            thumbWrap.appendChild(badge);
            previewDiv.appendChild(thumbWrap);
          };
          reader.readAsDataURL(file);
        });
      }
    }

    function resetGameForm() {
      document.getElementById('gameForm').reset();
      document.getElementById('game_id').value = '';
      document.getElementById('game_screenshots').value = '';
      document.getElementById('game_iconFile').value = '';
      document.getElementById('game_bannerFile').value = '';
      document.getElementById('game_screenshotFiles').value = '';
      document.getElementById('iconPreview').style.display = 'none';
      document.getElementById('bannerPreview').style.display = 'none';
      document.getElementById('screenshotsFilesPreview').innerHTML = '';
      const dzIcon = document.getElementById('dropzone_icon_label');
      if (dzIcon) dzIcon.textContent = 'Subir Icono desde tu PC';
      const dzBanner = document.getElementById('dropzone_banner_label');
      if (dzBanner) dzBanner.textContent = 'Subir Banner Panorámico HD';
      const dzScreens = document.getElementById('dropzone_screenshots_label');
      if (dzScreens) dzScreens.textContent = 'Seleccionar Capturas de Pantalla Múltiples';
      document.getElementById('formTitle').textContent = 'Agregar Nuevo Juego al Catálogo';
      document.getElementById('downloadFilesContainer').innerHTML = '';
      fileCounter = 0;
      // Añadir 1 fila inicial por defecto
      addDownloadFileRow({ name: 'Instalador Principal APK', type: 'APK', size: '100 MB', badge: 'Principal', url: '' });
    }

    function editGame(game) {
      switchTab('tab-nuevo');
      document.getElementById('formTitle').textContent = 'Editar Juego: ' + game.title;
      document.getElementById('game_id').value = game.id;
      document.getElementById('game_title').value = game.title || '';
      document.getElementById('game_category').value = game.category || 'Acción';
      document.getElementById('game_badge').value = game.badge || 'MOD APK';
      document.getElementById('game_version').value = game.version || '';
      document.getElementById('game_size').value = game.size || '';
      document.getElementById('game_requiresAndroid').value = game.requiresAndroid || '';
      document.getElementById('game_developer').value = game.developer || '';
      document.getElementById('game_rating').value = game.rating || 4.8;
      document.getElementById('game_icon').value = game.icon || '';
      document.getElementById('game_banner').value = game.banner || '';
      document.getElementById('game_shortDescription').value = game.shortDescription || '';
      document.getElementById('game_description').value = game.description || '';
      document.getElementById('game_modFeatures').value = (game.modFeatures || []).join('\n');
      document.getElementById('game_screenshots').value = (game.screenshots || []).join('\n');
      document.getElementById('game_featured').checked = !!game.featured;

      // Limpiar inputs de archivos de PC
      document.getElementById('game_iconFile').value = '';
      document.getElementById('game_bannerFile').value = '';
      document.getElementById('game_screenshotFiles').value = '';
      document.getElementById('screenshotsFilesPreview').innerHTML = '';

      // Actualizar textos informativos en los dropzones
      const dzIcon = document.getElementById('dropzone_icon_label');
      if (dzIcon) dzIcon.textContent = game.icon ? 'Icono actual configurado (clic para reemplazar)' : 'Subir Icono desde tu PC';
      const dzBanner = document.getElementById('dropzone_banner_label');
      if (dzBanner) dzBanner.textContent = game.banner ? 'Banner actual configurado (clic para reemplazar)' : 'Subir Banner Panorámico HD';
      const dzScreens = document.getElementById('dropzone_screenshots_label');
      if (dzScreens) dzScreens.textContent = (game.screenshots && game.screenshots.length > 0) ? (game.screenshots.length + ' capturas existentes (clic para subir nuevas)') : 'Seleccionar Capturas de Pantalla Múltiples';

      // Mostrar previsualización de imágenes existentes
      if (game.icon) {
        document.getElementById('iconPreviewImg').src = game.icon;
        document.getElementById('iconPreview').style.display = 'flex';
      } else {
        document.getElementById('iconPreview').style.display = 'none';
      }

      if (game.banner) {
        document.getElementById('bannerPreviewImg').src = game.banner;
        document.getElementById('bannerPreview').style.display = 'flex';
      } else {
        document.getElementById('bannerPreview').style.display = 'none';
      }

      // Cargar todos los enlaces de descarga dinámicos
      const container = document.getElementById('downloadFilesContainer');
      container.innerHTML = '';
      fileCounter = 0;

      if (game.downloadFiles && game.downloadFiles.length > 0) {
        game.downloadFiles.forEach(file => {
          addDownloadFileRow(file);
        });
      } else if (game.downloadUrl) {
        addDownloadFileRow({
          name: game.title + ' (' + (game.badge || 'APK') + ')',
          type: game.badge || 'APK',
          size: game.size || '100 MB',
          badge: 'Principal',
          url: game.downloadUrl
        });
      } else {
        addDownloadFileRow();
      }
    }

    // ================= AUTOGUARDADO DE BORRADOR (LOCALSTORAGE) =================
    const DRAFT_KEY = 'aura_admin_game_draft';
    let isSubmitting = false;

    function saveFormDraft() {
      const gameId = document.getElementById('game_id').value;
      if (gameId) return; // Si estamos editando un juego existente, no sobreescribir el borrador de juego nuevo

      const draft = {
        title: document.getElementById('game_title').value,
        category: document.getElementById('game_category').value,
        badge: document.getElementById('game_badge').value,
        version: document.getElementById('game_version').value,
        size: document.getElementById('game_size').value,
        requiresAndroid: document.getElementById('game_requiresAndroid').value,
        developer: document.getElementById('game_developer').value,
        rating: document.getElementById('game_rating').value,
        icon: document.getElementById('game_icon').value,
        banner: document.getElementById('game_banner').value,
        shortDescription: document.getElementById('game_shortDescription').value,
        description: document.getElementById('game_description').value,
        modFeatures: document.getElementById('game_modFeatures').value,
        screenshots: document.getElementById('game_screenshots').value,
        featured: document.getElementById('game_featured').checked,
        timestamp: Date.now()
      };

      const fileRows = [];
      document.querySelectorAll('#downloadFilesContainer .download-file-row').forEach(row => {
        const name = row.querySelector('input[name="file_name[]"]')?.value || '';
        const type = row.querySelector('input[name="file_type[]"]')?.value || '';
        const size = row.querySelector('input[name="file_size[]"]')?.value || '';
        const badge = row.querySelector('input[name="file_badge[]"]')?.value || '';
        const url = row.querySelector('input[name="file_url[]"]')?.value || '';
        if (name || url) {
          fileRows.push({ name, type, size, badge, url });
        }
      });
      draft.downloadFiles = fileRows;

      if (draft.title || draft.description || draft.shortDescription || fileRows.length > 0) {
        localStorage.setItem(DRAFT_KEY, JSON.stringify(draft));
      }
    }

    function restoreFormDraft() {
      const gameId = document.getElementById('game_id').value;
      if (gameId) return;

      const saved = localStorage.getItem(DRAFT_KEY);
      if (!saved) return;

      try {
        const draft = JSON.parse(saved);
        if (draft.title || draft.description || draft.shortDescription) {
          if (draft.title) document.getElementById('game_title').value = draft.title;
          if (draft.category) document.getElementById('game_category').value = draft.category;
          if (draft.badge) document.getElementById('game_badge').value = draft.badge;
          if (draft.version) document.getElementById('game_version').value = draft.version;
          if (draft.size) document.getElementById('game_size').value = draft.size;
          if (draft.requiresAndroid) document.getElementById('game_requiresAndroid').value = draft.requiresAndroid;
          if (draft.developer) document.getElementById('game_developer').value = draft.developer;
          if (draft.rating) document.getElementById('game_rating').value = draft.rating;
          if (draft.icon) document.getElementById('game_icon').value = draft.icon;
          if (draft.banner) document.getElementById('game_banner').value = draft.banner;
          if (draft.shortDescription) document.getElementById('game_shortDescription').value = draft.shortDescription;
          if (draft.description) document.getElementById('game_description').value = draft.description;
          if (draft.modFeatures) document.getElementById('game_modFeatures').value = draft.modFeatures;
          if (draft.screenshots) document.getElementById('game_screenshots').value = draft.screenshots;
          if (draft.featured !== undefined) document.getElementById('game_featured').checked = draft.featured;

          if (draft.downloadFiles && draft.downloadFiles.length > 0) {
            const container = document.getElementById('downloadFilesContainer');
            container.innerHTML = '';
            draft.downloadFiles.forEach(f => addDownloadFileRow(f));
          }

          const alertBox = document.getElementById('draftAlert');
          if (alertBox) alertBox.style.display = 'flex';
        }
      } catch (e) {
        console.error('Error restaurando borrador:', e);
      }
    }

    function clearGameDraft() {
      localStorage.removeItem(DRAFT_KEY);
      const alertBox = document.getElementById('draftAlert');
      if (alertBox) alertBox.style.display = 'none';
      document.getElementById('gameForm').reset();
      const container = document.getElementById('downloadFilesContainer');
      container.innerHTML = '';
      addDownloadFileRow({ name: 'Instalador Principal APK', type: 'APK', size: '100 MB', badge: 'Principal', url: '' });
    }

    // Escuchar cambios en cualquier input para guardar borrador en tiempo real
    document.addEventListener('input', (e) => {
      if (e.target.closest('#gameForm')) {
        saveFormDraft();
      }
    });

    document.addEventListener('change', (e) => {
      if (e.target.closest('#gameForm')) {
        saveFormDraft();
      }
    });

    // Limpiar borrador al enviar con éxito
    const gameFormEl = document.getElementById('gameForm');
    if (gameFormEl) {
      gameFormEl.addEventListener('submit', () => {
        isSubmitting = true;
        localStorage.removeItem(DRAFT_KEY);
      });
    }

    // Inicializar con 1 fila por defecto y restaurar borrador si existe
    document.addEventListener('DOMContentLoaded', () => {
      const container = document.getElementById('downloadFilesContainer');
      if (container && container.children.length === 0) {
        addDownloadFileRow({ name: 'Instalador Principal APK', type: 'APK', size: '100 MB', badge: 'Principal', url: '' });
      }
      setupDragAndDrop();
      restoreFormDraft();
    });
  </script>

</body>
</html>
