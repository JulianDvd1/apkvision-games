<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="<%= metaDesc %>">
  <meta name="referrer" content="no-referrer">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <meta name="keywords" content="<%= typeof metaKeywords !== 'undefined' && metaKeywords ? metaKeywords : 'descargar apk, juegos android gratis, mod apk, roms android, port android' %>">
  
  <!-- Open Graph / Redes Sociales / Google SEO -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= metaDesc %>">
  <meta property="og:site_name" content="AuraAPK">
  <meta property="og:url" content="<%= siteUrl %><%= currentPath %>">
  <meta property="og:image" content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : (siteUrl + '/images/placeholder-game.svg') %>">
  <link rel="canonical" href="<%= siteUrl %><%= currentPath %>">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= title %>">
  <meta name="twitter:description" content="<%= metaDesc %>">
  <meta name="twitter:image" content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : (siteUrl + '/images/placeholder-game.svg') %>">

  <!-- Google Rich Snippets / Schema.org JSON-LD -->
  <% if (typeof schemaJson !== 'undefined' && schemaJson) { %>
    <script type="application/ld+json">
      <%- JSON.stringify(schemaJson) %>
    </script>
  <% } %>
  
  <!-- Favicon / Estilos -->
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link rel="apple-touch-icon" href="/images/logo.png">
  <link rel="stylesheet" href="/css/style.css?v=2.6">
</head>
<body>

  <!-- Fondo Gamer Animado Global Sutil (Aura Cósmica) -->
  <div class="aura-global-gamer-bg" aria-hidden="true">
    <div class="aura-global-stream">
      <img src="/images/aura-gamer-bg.svg" class="aura-global-svg" alt="">
    </div>
  </div>

  <!-- Header Principal -->
  <header class="main-header">
    <div class="container header-inner">
      <!-- Logo -->
      <a href="/" class="logo-area">
        <img src="/images/logo.png" alt="AuraAPK Logo" class="logo-img">
        <div class="logo-text">Aura<span>APK</span></div>
      </a>

      <!-- Buscador en tiempo real -->
      <div class="search-container">
        <div class="search-input-wrapper">
          <svg class="search-icon" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8"></circle>
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35"></path>
          </svg>
          <input 
            type="text" 
            id="mainSearchInput" 
            class="search-input" 
            placeholder="Buscar juegos, mods, acción, carreras..." 
            autocomplete="off"
          >
        </div>
        <!-- Dropdown con resultados en tiempo real -->
        <div id="searchResultsDropdown" class="search-results-dropdown"></div>
      </div>

      <!-- Navegación -->
      <nav class="header-nav" id="headerNavLinks">
        <a href="/" class="nav-link <%= currentPath === '/' ? 'active' : '' %>">Inicio</a>
        <a href="/categoria/todos" class="nav-link <%= currentPath.startsWith('/categoria') ? 'active' : '' %>">Juegos</a>
        <a href="/categoria/accion" class="nav-link">Top Acción</a>
        <a href="/categoria/carreras" class="nav-link">Carreras</a>
      </nav>

      <!-- Botón móvil -->
      <button class="mobile-toggle" id="mobileNavToggle" aria-label="Abrir menú">
        ☰
      </button>
    </div>
  </header>

  <!-- Barra de Categorías / Menú Compacto por Géneros (Organizado y con Glassmorphism) -->
  <nav class="categories-bar" aria-label="Categorías de juegos">
    <div class="container categories-wrapper">
      <div class="categories-scroll" id="categoriesScroll">
        
        <!-- Píldora: Todos -->
        <a 
          href="/categoria/todos" 
          class="category-pill <%= (typeof activeCategory !== 'undefined' && activeCategory === 'todos') ? 'active' : '' %>"
        >
          <span class="cat-icon">✨</span>
          <span class="cat-label">Todos</span>
        </a>

        <!-- Grupo: Acción & Combate -->
        <div class="category-dropdown <%= (typeof activeCategory !== 'undefined' && ['grupo-accion', 'accion', 'disparos', 'lucha'].includes(activeCategory)) ? 'active' : '' %>">
          <a href="/categoria/grupo-accion" class="category-pill dropdown-trigger">
            <span class="cat-icon">⚔️</span>
            <span class="cat-label">Acción & Combate</span>
            <span class="cat-chevron">▾</span>
          </a>
          <div class="category-dropdown-menu">
            <a href="/categoria/accion" class="dropdown-item <%= (typeof activeCategory !== 'undefined' && activeCategory === 'accion') ? 'active' : '' %>">
              <span class="cat-icon">💥</span> Acción
            </a>
            <a href="/categoria/disparos" class="dropdown-item <%= (typeof activeCategory !== 'undefined' && activeCategory === 'disparos') ? 'active' : '' %>">
              <span class="cat-icon">🎯</span> Disparos (Shooter)
            </a>
            <a href="/categoria/lucha" class="dropdown-item <%= (typeof activeCategory !== 'undefined' && activeCategory === 'lucha') ? 'active' : '' %>">
              <span class="cat-icon">🥊</span> Lucha & Pelea
            </a>
          </div>
        </div>

        <!-- Grupo: Aventura & Rol -->
        <div class="category-dropdown <%= (typeof activeCategory !== 'undefined' && ['grupo-aventura', 'aventura', 'rpg', 'terror'].includes(activeCategory)) ? 'active' : '' %>">
          <a href="/categoria/grupo-aventura" class="category-pill dropdown-trigger">
            <span class="cat-icon">🧭</span>
            <span class="cat-label">Aventura & Rol</span>
            <span class="cat-chevron">▾</span>
          </a>
          <div class="category-dropdown-menu">
            <a href="/categoria/aventura" class="dropdown-item <%= (typeof activeCategory !== 'undefined' && activeCategory === 'aventura') ? 'active' : '' %>">
              <span class="cat-icon">🧭</span> Aventura
            </a>
            <a href="/categoria/rpg" class="dropdown-item <%= (typeof activeCategory !== 'undefined' && activeCategory === 'rpg') ? 'active' : '' %>">
              <span class="cat-icon">🛡️</span> RPG
            </a>
            <a href="/categoria/terror" class="dropdown-item <%= (typeof activeCategory !== 'undefined' && activeCategory === 'terror') ? 'active' : '' %>">
              <span class="cat-icon">🧟</span> Terror & Supervivencia
            </a>
          </div>
        </div>

        <!-- Grupo: Deportes & Velocidad -->
        <div class="category-dropdown <%= (typeof activeCategory !== 'undefined' && ['grupo-deportes', 'deportes', 'carreras'].includes(activeCategory)) ? 'active' : '' %>">
          <a href="/categoria/grupo-deportes" class="category-pill dropdown-trigger">
            <span class="cat-icon">🏎️</span>
            <span class="cat-label">Deportes & Velocidad</span>
            <span class="cat-chevron">▾</span>
          </a>
          <div class="category-dropdown-menu">
            <a href="/categoria/deportes" class="dropdown-item <%= (typeof activeCategory !== 'undefined' && activeCategory === 'deportes') ? 'active' : '' %>">
              <span class="cat-icon">⚽</span> Deportes
            </a>
            <a href="/categoria/carreras" class="dropdown-item <%= (typeof activeCategory !== 'undefined' && activeCategory === 'carreras') ? 'active' : '' %>">
              <span class="cat-icon">🏎️</span> Carreras
            </a>
          </div>
        </div>

        <!-- Grupo: Estrategia & Simulación -->
        <div class="category-dropdown <%= (typeof activeCategory !== 'undefined' && ['grupo-estrategia', 'estrategia', 'simulacion'].includes(activeCategory)) ? 'active' : '' %>">
          <a href="/categoria/grupo-estrategia" class="category-pill dropdown-trigger">
            <span class="cat-icon">♟️</span>
            <span class="cat-label">Estrategia & Simulación</span>
            <span class="cat-chevron">▾</span>
          </a>
          <div class="category-dropdown-menu">
            <a href="/categoria/estrategia" class="dropdown-item <%= (typeof activeCategory !== 'undefined' && activeCategory === 'estrategia') ? 'active' : '' %>">
              <span class="cat-icon">♟️</span> Estrategia
            </a>
            <a href="/categoria/simulacion" class="dropdown-item <%= (typeof activeCategory !== 'undefined' && activeCategory === 'simulacion') ? 'active' : '' %>">
              <span class="cat-icon">🚜</span> Simulación
            </a>
          </div>
        </div>

        <!-- Píldora: Arcade -->
        <a 
          href="/categoria/arcade" 
          class="category-pill <%= (typeof activeCategory !== 'undefined' && activeCategory === 'arcade') ? 'active' : '' %>"
        >
          <span class="cat-icon">🕹️</span>
          <span class="cat-label">Arcade</span>
        </a>

      </div>
    </div>
  </nav>

  <!-- Banner Publicitario Superior (Adsterra Header 728x90) -->
  <div class="container">
    <%- include('ad-slot', { 
      slot: adsConfig.slots.headerBanner, 
      sizeClass: 'size-728x90', 
      customClass: 'header-ad-banner' 
    }) %>
  </div>

  <!-- Contenedor Principal de la Página -->
  <main class="container">
