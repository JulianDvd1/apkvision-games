<%- include('partials/header') %>

<!-- FICHA TÉCNICA PRINCIPAL DEL JUEGO -->
<article class="game-detail-header">
  <div class="game-detail-banner">
    <img src="<%= game.banner || game.icon %>" alt="<%= game.title %> Banner" onerror="this.src='/images/placeholder-game.svg'">
  </div>

  <div class="game-detail-main">
    <img src="<%= game.icon %>" alt="<%= game.title %> Icon" class="game-icon-large" onerror="this.src='/images/placeholder-game.svg'">

    <div class="game-info-col">
      <h1 class="game-info-title"><%= game.title %></h1>
      
      <div class="game-info-meta">
        <span class="game-badge <%= game.badge.toLowerCase().includes('mod') ? 'mod' : '' %>" style="position: static;">
          <%= game.badge %>
        </span>
        <span>•</span>
        <span><%= game.category %></span>
        <span>•</span>
        <span style="color: var(--accent-amber); font-weight: 700;">★ <%= game.rating %></span>
        <span>•</span>
        <span><%= game.downloadsCount %> descargas</span>
      </div>

      <p style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6;">
        <%= game.shortDescription %>
      </p>

      <!-- Botón de Salto a Enlaces de Descarga (Obliga a hacer scroll pasando por anuncios) -->
      <div style="margin-top: 1.5rem; display: flex; flex-direction: column; gap: 0.85rem;">
        <a href="#zona-descargas" class="btn btn-primary" style="display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 0.95rem 1.6rem; font-size: 1.05rem; font-weight: 800; border-radius: var(--radius-md); max-width: 460px; box-shadow: 0 0 25px rgba(16, 185, 129, 0.35); text-decoration: none;">
          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
          </svg>
          <span>Ir a Enlaces de Descarga (<%= game.size %>)</span>
        </a>

        <div style="font-size: 0.8rem; color: var(--text-muted); display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
          <span>🔒 Verificado y libre de virus</span>
          <span>•</span>
          <span>⚡ Servidores de alta velocidad</span>
          <span>•</span>
          <span>📱 Compatible con Android</span>
        </div>

        <!-- Botones de Compartir Rápido (Generador de Tráfico Viral) -->
        <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-top: 0.5rem; padding-top: 0.75rem; border-top: 1px solid rgba(255, 255, 255, 0.06);">
          <span style="font-size: 0.78rem; color: var(--text-muted); font-weight: 600;">Compartir:</span>
          
          <a href="https://api.whatsapp.com/send?text=Descarga%20<%= encodeURIComponent(game.title) %>%20gratis%20en%20AuraAPK:%20<%= encodeURIComponent(siteUrl + '/juego/' + game.slug) %>" target="_blank" rel="noopener" class="btn btn-secondary" style="padding: 4px 10px; font-size: 0.78rem; border-radius: 9999px;">
            <span>💬 WhatsApp</span>
          </a>
          
          <a href="https://t.me/share/url?url=<%= encodeURIComponent(siteUrl + '/juego/' + game.slug) %>&text=Descarga%20<%= encodeURIComponent(game.title) %>%20en%20AuraAPK" target="_blank" rel="noopener" class="btn btn-secondary" style="padding: 4px 10px; font-size: 0.78rem; border-radius: 9999px;">
            <span>✈️ Telegram</span>
          </a>

          <button type="button" class="btn btn-secondary" style="padding: 4px 10px; font-size: 0.78rem; border-radius: 9999px;" onclick="copyGameLink(this)">
            <span>📋 Copiar Enlace</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</article>

<!-- Banner Adsterra 728x90 Leaderboard / 320x50 Móvil -->
<div style="margin: 1.5rem 0;">
  <%- include('partials/ad-slot', { 
    slot: adsConfig.slots.headerBanner, 
    sizeClass: 'size-728x90', 
    customClass: 'game-detail-header-ad' 
  }) %>
</div>

<!-- LAYOUT PRINCIPAL: CONTENIDO + SIDEBAR (ESTILO APKVISION) -->
<div class="game-detail-layout">
  
  <!-- COLUMNA PRINCIPAL (IZQUIERDA) -->
  <div class="game-main-content">

    <!-- Caja de Mod Features con Glow Verde -->
    <% if (game.modFeatures && game.modFeatures.length > 0) { %>
      <div class="mod-box">
        <div class="mod-box-title">
          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          Ventajas y Características del MOD
        </div>
        <ul class="mod-features-list">
          <% game.modFeatures.forEach(feat => { %>
            <li>
              <span style="color: var(--accent-green); font-size: 1rem; line-height: 1;">✦</span>
              <span><%= feat %></span>
            </li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <!-- Ficha Técnica Balanceada -->
    <div style="background: var(--bg-card); backdrop-filter: blur(10px); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 1.5rem; box-shadow: var(--shadow-card);">
      <h3 style="font-size: 1.15rem; font-weight: 800; margin-bottom: 0.85rem; color: var(--text-primary); display: flex; align-items: center; gap: 8px;">
        <span style="color: var(--accent-green);">📋</span> Ficha Técnica del Archivo
      </h3>
      <table class="info-table">
        <tbody>
          <tr>
            <td class="label">Nombre del juego:</td>
            <td class="value"><%= game.title %></td>
          </tr>
          <tr>
            <td class="label">Versión actual:</td>
            <td class="value"><%= game.version %></td>
          </tr>
          <tr>
            <td class="label">Tamaño del archivo:</td>
            <td class="value"><%= game.size %></td>
          </tr>
          <tr>
            <td class="label">Requisitos mínimos:</td>
            <td class="value"><%= game.requiresAndroid %></td>
          </tr>
          <tr>
            <td class="label">Desarrollador oficial:</td>
            <td class="value"><%= game.developer %></td>
          </tr>
          <tr>
            <td class="label">Última actualización:</td>
            <td class="value"><%= game.updatedAt %></td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Descripción Detallada -->
    <div style="background: var(--bg-card); backdrop-filter: blur(10px); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 1.8rem; box-shadow: var(--shadow-card);">
      <h3 style="font-size: 1.2rem; font-weight: 800; margin-bottom: 0.85rem;">
        Acerca de <%= game.title %>
      </h3>
      <div style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.75; white-space: pre-line;">
        <%= game.description %>
      </div>

      <% if (game.downloadFiles && game.downloadFiles.length > 1) { 
           const hasIso = game.downloadFiles.some(f => (f.type || '').toUpperCase().includes('ISO'));
           const hasObb = game.downloadFiles.some(f => (f.type || '').toUpperCase().includes('OBB'));
           const hasZip = game.downloadFiles.some(f => (f.type || '').toUpperCase().includes('ZIP') || (f.type || '').toUpperCase().includes('HD'));
      %>
        <div style="margin-top: 1.6rem; background: rgba(6, 182, 212, 0.08); border: 1px solid rgba(6, 182, 212, 0.3); border-radius: var(--radius-md); padding: 1.25rem;">
          <h4 style="font-size: 1rem; font-weight: 800; color: var(--accent-cyan); display: flex; align-items: center; gap: 8px; margin-bottom: 0.6rem;">
            <span>💡</span> Guía de Instalación Rápida en Móvil:
          </h4>
          <ol style="color: var(--text-secondary); font-size: 0.88rem; line-height: 1.65; padding-left: 1.2rem; display: flex; flex-direction: column; gap: 6px;">
            <li><strong>Descarga el APK</strong> e instálalo en tu dispositivo Android.</li>
            <% if (hasObb) { %>
              <li><strong>Descarga los Datos OBB</strong> y mueve el archivo o carpeta descomprimida a la ruta interna <code>Android/obb/</code>.</li>
            <% } %>
            <% if (hasIso) { %>
              <li><strong>Descarga la ROM ISO</strong> del juego y guárdala en una carpeta accesible (por ejemplo, en <code>Download</code>).</li>
            <% } %>
            <% if (hasZip) { %>
              <li><em>(Opcional):</em> Descarga el pack de texturas y descomprímelo dentro de la carpeta correspondientes para gráficos mejorados en alta definición.</li>
            <% } %>
            <li>Abre el juego desde tu menú de aplicaciones, concede los permisos de almacenamiento y ¡a jugar!</li>
          </ol>
        </div>
      <% } %>
    </div>

    <!-- Capturas de Pantalla con Lightbox Interactivo -->
    <% if (game.screenshots && game.screenshots.length > 0) { %>
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin: 1.5rem 0 0.9rem;">
          <h3 style="font-size: 1.2rem; font-weight: 800; display: flex; align-items: center; gap: 8px; margin: 0;">
            <span>📸</span> Capturas de Pantalla (Clic para agrandar)
          </h3>
          <span style="font-size: 0.8rem; color: var(--text-muted); display: flex; align-items: center; gap: 4px;">
            <span>Desliza para ver más</span>
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </span>
        </div>
        <div class="screenshots-wrap">
          <% game.screenshots.forEach((screen, i) => { %>
            <div class="screenshot-item" onclick="openLightbox('<%= screen %>')">
              <img src="<%= screen %>" alt="Captura <%= i + 1 %> de <%= game.title %>" loading="lazy">
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

    <!-- Anuncio Adsterra ENCIMA de la Zona de Descargas (Solo en Móvil para monetizar antes del botón) -->
    <div class="mobile-only-ad" style="margin: 1.5rem 0;">
      <%- include('partials/ad-slot', { 
        slot: adsConfig.slots.inFeedNative, 
        sizeClass: 'size-728x90', 
        customClass: 'before-download-mobile-ad' 
      }) %>
    </div>

    <!-- ZONA OFICIAL DE DESCARGAS (AL FINAL PARA OBLIGAR A PASAR POR ANUNCIOS Y DESCRIPCIÓN) -->
    <div id="zona-descargas" style="margin: 2rem 0; padding: 2.2rem 1.8rem; background: linear-gradient(145deg, rgba(22, 31, 51, 0.85) 0%, rgba(14, 20, 33, 0.98) 100%); border-radius: var(--radius-xl); border: 1px solid rgba(16, 185, 129, 0.35); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4), 0 0 25px rgba(16, 185, 129, 0.15); scroll-margin-top: 80px;">
      
      <div style="text-align: center; margin-bottom: 1.8rem;">
        <span style="background: rgba(16, 185, 129, 0.15); color: var(--accent-green); font-size: 0.78rem; font-weight: 800; padding: 4px 12px; border-radius: 9999px; text-transform: uppercase; letter-spacing: 0.05em; border: 1px solid rgba(16, 185, 129, 0.3);">
          ⚡ Zona Oficial de Descargas
        </span>
        <h3 style="font-size: 1.45rem; font-weight: 800; margin: 0.7rem 0 0.3rem; color: var(--text-primary);">
          Descargar <%= game.title %>
        </h3>
        <p style="color: var(--text-secondary); font-size: 0.9rem; max-width: 520px; margin: 0 auto;">
          Selecciona los archivos correspondientes a tu instalación. Todos los enlaces son seguros y verificados.
        </p>
      </div>

      <% if (game.downloadFiles && game.downloadFiles.length > 0) { %>
        <div style="display: flex; flex-direction: column; gap: 12px; max-width: 540px; margin: 0 auto;">
          <% game.downloadFiles.forEach((file, fIdx) => { %>
            <a href="/descargar/<%= game.slug %>?f=<%= fIdx %>" class="btn btn-primary" style="justify-content: space-between; padding: 1rem 1.35rem; font-size: 0.98rem; border-radius: var(--radius-md); box-shadow: 0 4px 15px rgba(0, 0, 0, 0.25);">
              <div style="display: flex; align-items: center; gap: 12px; text-align: left; min-width: 0;">
                <span style="background: rgba(0,0,0,0.35); padding: 4px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; flex-shrink: 0; color: var(--accent-cyan); border: 1px solid rgba(6, 182, 212, 0.3);">
                  <%= file.type || 'ARCHIVO' %>
                </span>
                <div style="min-width: 0;">
                  <strong style="display: block; font-size: 0.94rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= file.name %></strong>
                  <span style="font-size: 0.78rem; opacity: 0.85;"><%= file.badge || 'Descarga Directa' %></span>
                </div>
              </div>
              <div style="display: flex; align-items: center; gap: 10px; flex-shrink: 0;">
                <span style="font-size: 0.88rem; font-weight: 800; background: rgba(0,0,0,0.25); padding: 3px 8px; border-radius: 6px;"><%= file.size %></span>
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                </svg>
              </div>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <div style="max-width: 480px; margin: 0 auto; text-align: center;">
          <a href="/descargar/<%= game.slug %>" class="btn btn-download-big">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
            </svg>
            DESCARGAR ARCHIVO COMPLETO (<%= game.size %>)
          </a>
        </div>
      <% } %>

      <div style="margin-top: 1.5rem; padding-top: 1.2rem; border-top: 1px solid rgba(255, 255, 255, 0.08); display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; font-size: 0.82rem; color: var(--text-muted);">
        <span style="display: flex; align-items: center; gap: 5px;">🛡️ Analizado con VirusTotal</span>
        <span style="display: flex; align-items: center; gap: 5px;">🚀 Servidores Cloud de alta velocidad</span>
        <span style="display: flex; align-items: center; gap: 5px;">💯 100% Funcional y Verificado</span>
      </div>
    </div>

    <!-- Anuncio Adsterra debajo de la Zona de Descargas (Máximo CTR y Visibilidad) -->
    <div style="margin: 1.5rem 0;">
      <%- include('partials/ad-slot', { 
        slot: adsConfig.slots.inFeedNative, 
        sizeClass: 'size-728x90', 
        customClass: 'bottom-download-ad' 
      }) %>
    </div>

  </div>

  <!-- COLUMNA LATERAL: SIDEBAR (DERECHA) -->
  <aside class="game-sidebar">
    
    <!-- Anuncio Adsterra 300x250 en Sidebar (Solo visible en PC para no duplicar en móvil) -->
    <div class="desktop-only-ad">
      <%- include('partials/ad-slot', { 
        slot: adsConfig.slots.gameDetailTop, 
        sizeClass: 'size-300x250', 
        customClass: 'sidebar-ad-banner' 
      }) %>
    </div>

    <!-- Widget: Juegos Más Populares -->
    <% if (typeof popularGames !== 'undefined' && popularGames.length > 0) { %>
      <div class="sidebar-widget">
        <h4 class="sidebar-widget-title">
          <span>🔥</span> Top Juegos Populares
        </h4>
        <div class="sidebar-game-list">
          <% popularGames.forEach(pop => { %>
            <a href="/juego/<%= pop.slug %>" class="sidebar-game-item">
              <img src="<%= pop.icon %>" alt="<%= pop.title %>" class="sidebar-game-thumb" onerror="this.src='/images/placeholder-game.svg'">
              <div class="sidebar-game-info">
                <div class="sidebar-game-title"><%= pop.title %></div>
                <div class="sidebar-game-meta">
                  <span style="color: var(--accent-amber); font-weight: 700;">★ <%= pop.rating %></span>
                  <span>•</span>
                  <span><%= pop.category %></span>
                </div>
              </div>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>

    <!-- Widget: Garantía de Seguridad -->
    <div class="sidebar-widget" style="background: rgba(16, 185, 129, 0.05); border-color: rgba(16, 185, 129, 0.2);">
      <h4 class="sidebar-widget-title" style="color: var(--accent-green); font-size: 0.95rem;">
        <span>🛡️</span> Descargas 100% Seguras
      </h4>
      <p style="font-size: 0.82rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 0.6rem;">
        Todos nuestros archivos son verificados periódicamente contra virus y amenazas antes de ser publicados.
      </p>
      <div style="font-size: 0.78rem; color: var(--accent-cyan); display: flex; align-items: center; gap: 6px; font-weight: 700;">
        <span>✓ Verificado con antivirus</span>
      </div>
    </div>

    <!-- Anuncio Vertical Largo 300x600 Half Page / Skyscraper (Llena el espacio derecho) -->
    <%- include('partials/ad-slot', { 
      slot: adsConfig.slots.sidebarSticky, 
      sizeClass: 'size-300x600', 
      customClass: 'sidebar-skyscraper-ad' 
    }) %>

  </aside>

</div>

<!-- Lightbox Modal -->
<div id="imageLightboxModal" class="lightbox-modal" onclick="closeLightbox()">
  <button class="lightbox-close" onclick="closeLightbox()" aria-label="Cerrar">&times;</button>
  <img id="lightboxImage" src="" alt="Captura de Pantalla" class="lightbox-img" onclick="event.stopPropagation()">
</div>

<!-- JUEGOS RELACIONADOS AL FINAL -->
<% if (relatedGames && relatedGames.length > 0) { %>
  <div class="section-header" style="margin-top: 3.5rem;">
    <h3 class="section-title">
      <span class="bar"></span>
      Juegos Similares que te pueden gustar
    </h3>
  </div>

  <div class="games-grid">
    <% relatedGames.forEach(rel => { %>
      <article class="game-card cascade-item" data-tilt>
        <a href="/juego/<%= rel.slug %>" style="display: flex; flex-direction: column; height: 100%;">
          <div class="game-card-thumb-wrap">
            <img 
              src="<%= rel.icon || rel.banner %>" 
              alt="" 
              class="game-card-thumb-ambient" 
              loading="lazy"
              aria-hidden="true"
            >
            <div class="game-card-icon-box">
              <img 
                src="<%= rel.icon || rel.banner %>" 
                alt="<%= rel.title %>" 
                class="game-card-thumb" 
                loading="lazy"
                onerror="this.src='/images/placeholder-game.svg'"
              >
            </div>
            <span class="game-badge <%= rel.badge && rel.badge.toLowerCase().includes('mod') ? 'mod' : '' %>">
              <%= rel.badge %>
            </span>
            <span class="game-version-badge">
              <%= rel.version %>
            </span>
          </div>
          <div class="game-card-body">
            <h4 class="game-card-title"><%= rel.title %></h4>
            <div class="game-card-cat"><%= rel.category %></div>
            <div class="game-card-footer">
              <span class="game-rating">★ <%= rel.rating %></span>
              <span class="game-size"><%= rel.size %></span>
            </div>
          </div>
        </a>
      </article>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>
