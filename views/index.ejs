<%- include('partials/header') %>

<!-- HERO SECTION: Juego Destacado con Aura Neón & Pop-Out 3D (Combinación A + C) -->
<% if (featuredGames && featuredGames.length > 0) { 
    const hero = featuredGames[0];
%>
<section class="hero-section">
  <!-- Aura Neón y Resplandor Ambiental de Fondo -->
  <div class="hero-glow-backdrop" aria-hidden="true"></div>

  <div class="hero-card">
    <div class="hero-content">
      
      <!-- Fila Superior: Badges y Tendencia -->
      <div class="hero-tags-row">
        <span class="hero-tag">🔥 JUEGO DESTACADO DEL DÍA</span>
        <span class="hero-chip-trend">⚡ #1 EN TENDENCIAS</span>
      </div>

      <!-- Cabecera con Icono Flotante 3D + Título + Microchips -->
      <div class="hero-header-row">
        <% if (hero.icon) { %>
          <div class="hero-icon-squircle">
            <img src="<%= hero.icon %>" alt="<%= hero.title %> Icono" onerror="this.src='/images/placeholder-game.svg'">
          </div>
        <% } %>
        <div class="hero-header-titles">
          <h1 class="hero-title"><%= hero.title %></h1>
          <!-- Fila de Micro-Badges de Impacto -->
          <div class="hero-meta-chips">
            <span class="hero-chip hero-chip-rating">★ <%= hero.rating %></span>
            <span class="hero-chip hero-chip-size">📦 <%= hero.size %></span>
            <span class="hero-chip hero-chip-badge">⚡ <%= hero.badge %></span>
            <span class="hero-chip hero-chip-cat"><%= hero.category %></span>
          </div>
        </div>
      </div>

      <p class="hero-desc"><%= hero.shortDescription %></p>

      <div class="hero-actions">
        <a href="/juego/<%= hero.slug %>" class="btn btn-hero-download">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          Descargar <%= hero.version %>
        </a>
        <a href="/juego/<%= hero.slug %>" class="btn btn-secondary hero-btn-sec">
          Ver Ficha Técnica ↗
        </a>
      </div>
    </div>

    <!-- Área de Imagen Limpia y Contenida (Opción A) -->
    <div class="hero-image-area">
      <img src="<%= hero.banner || hero.icon %>" alt="<%= hero.title %>" class="hero-img">
    </div>
  </div>
</section>
<% } %>

<!-- Banner Adsterra 728x90 Leaderboard / 320x50 Móvil -->
<div style="margin: 1.5rem 0 2rem;">
  <%- include('partials/ad-slot', { 
    slot: adsConfig.slots.headerBanner, 
    sizeClass: 'size-728x90', 
    customClass: 'header-leaderboard-ad' 
  }) %>
</div>

<!-- SECCIÓN: Catálogo de Juegos con Efecto Cascada -->
<div class="section-header">
  <h2 class="section-title">
    <span class="bar"></span>
    Juegos Recientes y Actualizados
  </h2>
  <span style="color: var(--text-muted); font-size: 0.85rem;">
    <%= recentGames.length %> disponibles
  </span>
</div>

<div class="games-grid">
  <% recentGames.forEach((game, index) => { %>
    <article class="game-card cascade-item" data-tilt>
      <a href="/juego/<%= game.slug %>" style="display: flex; flex-direction: column; height: 100%;">
        <div class="game-card-thumb-wrap">
          <!-- Fondo ambiental difuminado para atmósfera de color -->
          <img 
            src="<%= game.icon || game.banner %>" 
            alt="" 
            class="game-card-thumb-ambient" 
            loading="lazy"
            aria-hidden="true"
          >
          <!-- Icono móvil completo estilo App Store / Google Play -->
          <div class="game-card-icon-box">
            <img 
              src="<%= game.icon || game.banner %>" 
              alt="<%= game.title %>" 
              class="game-card-thumb" 
              loading="lazy"
              onerror="this.src='/images/placeholder-game.svg'"
            >
          </div>
          <span class="game-badge <%= game.badge.toLowerCase().includes('mod') ? 'mod' : '' %>">
            <%= game.badge %>
          </span>
          <span class="game-version-badge">
            <%= game.version %>
          </span>
        </div>

        <div class="game-card-body">
          <h3 class="game-card-title"><%= game.title %></h3>
          <div class="game-card-cat"><%= game.category %> • <%= game.developer %></div>
          
          <div class="game-card-footer">
            <span class="game-rating">
              ★ <%= game.rating %>
            </span>
            <span class="game-size">
              <%= game.size %>
            </span>
          </div>
        </div>
      </a>
    </article>
  <% }) %>
</div>

<!-- Banner Adsterra In-Feed al final del catálogo -->
<%- include('partials/ad-slot', { 
  slot: adsConfig.slots.inFeedNative, 
  sizeClass: 'size-728x90', 
  customClass: 'bottom-ad-banner' 
}) %>

<%- include('partials/footer') %>
